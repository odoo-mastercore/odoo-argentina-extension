<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="inherit_l10n_ar_tax_payment_view_form" model="ir.ui.view">
        <field name="name">inherit.l10n.ar.tax.payment.view.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="l10n_ar_tax.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_ar_withholding_line_ids']//list//field[@name='base_amount']" position="after">
                <field name="foreign_currency_id" column_invisible="1" />
                <field name="amount_currency" widget="monetary" options="{'currency_field': 'foreign_currency_id'}" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='withholdings_amount']" position="after">
                <field
                    name="withholding_amount_currency"
                    readonly="state != 'draft'"
                    invisible="not counterpart_currency_id or not use_payment_pro"
                    widget="monetary"
                    options="{'currency_field': 'counterpart_currency_id'}"
                    groups="base.group_multi_currency"
                    />
            </xpath>
        </field>
    </record>

    <record id="inherit_l10n_ar_tax_payment_withholding_view_form" model="ir.ui.view">
        <field name="name">inherit.l10n.ar.tax.payment.withholding.view.form</field>
        <field name="model">l10n_ar.payment.withholding</field>
        <field name="inherit_id" ref="l10n_ar_tax.view_l10n_ar_payment_withholding_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='base_amount']" position="after">
                <field name="foreign_currency_id" column_invisible="1"/>
                <field name="amount_currency" widget="monetary" options="{'currency_field': 'foreign_currency_id'}" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>