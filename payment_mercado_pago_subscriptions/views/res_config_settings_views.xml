<odoo>

    <record id="res_config_settings_view_form_mp_subscriptions" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.mp.subscriptions</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pay_invoice_online_setting_container']" position="after">
                <block title="Mercado Pago — Indexación de Suscripciones" id="mp_subscriptions_index_settings">
                    <setting id="mp_index_days_before_setting"
                             string="Días antes del cobro"
                             help="Anticipación con la que el cron recalcula y actualiza el monto del preapproval en MP.">
                        <field name="mp_index_days_before"/>
                    </setting>
                    <setting id="mp_index_threshold_percent_setting"
                             string="Umbral de cambio (%)"
                             help="Cambios menores a este % no se aplican (evita ruido por movimientos minúsculos de tasa).">
                        <field name="mp_index_threshold_percent"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
