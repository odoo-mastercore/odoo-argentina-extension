<odoo>
    <record id="l10n_ar_regular_basic_salary_rule" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll.BASIC"/>
        <field name="name">Sueldo básico</field>
        <field name="sequence">1</field>
        <field name="code">BASIC</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = payslip.paid_amount
        </field>
        <field name="struct_id" ref="l10n_ar_regular_pay"/>
    </record>

    <record id="l10n_ar_regular_seniority_salary_rule" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll.ALW"/>
        <field name="name">Antigüedad</field>
        <field name="sequence">10</field>
        <field name="code">AR_ANTIG</field>
        <field name="condition_select">python</field>
        <field name="condition_python">
result = version.l10n_ar_seniority_percent and payslip._l10n_ar_get_seniority_years() > 0
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
years = payslip._l10n_ar_get_seniority_years()
result = payslip.paid_amount * years * (version.l10n_ar_seniority_percent / 100.0)
        </field>
        <field name="struct_id" ref="l10n_ar_regular_pay"/>
    </record>

    <record id="l10n_ar_regular_gross_salary_rule" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll.GROSS"/>
        <field name="name">Remuneración bruta</field>
        <field name="sequence">100</field>
        <field name="code">GROSS</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = categories['BASIC'] + categories['ALW']
        </field>
        <field name="struct_id" ref="l10n_ar_regular_pay"/>
    </record>

    <record id="l10n_ar_regular_jubilacion_salary_rule" model="hr.salary.rule">
        <field name="category_id" ref="l10n_ar_hr_payroll.l10n_ar_category_employee_contrib"/>
        <field name="name">Jubilación</field>
        <field name="sequence">110</field>
        <field name="code">AR_JUB</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = -(categories['GROSS'] * payslip._rule_parameter('l10n_ar_employee_jubilacion_rate') / 100.0)
        </field>
        <field name="struct_id" ref="l10n_ar_regular_pay"/>
    </record>

