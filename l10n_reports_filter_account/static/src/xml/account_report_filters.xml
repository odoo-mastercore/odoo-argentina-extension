<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_reports_filter_account.AccountReportFilterExtraOptions" t-inherit="account_reports.AccountReportFilterExtraOptions" t-inherit-mode="extension" >
        <xpath expr="//t[@t-if=&quot;controller.filters.show_hide_0_lines !== 'never'&quot;]" position="after" >
            <t t-if="controller.filters.show_exclude_zero_balance !== 'never'">
                <DropdownItem
                    class="{ 'selected': controller.options.exclude_zero_balance }"
                    onSelected="() => this.filterClicked({
                        optionKey: 'exclude_zero_balance',
                        reload: true
                    })"
                >
                    Excluir balances en 0
                </DropdownItem>
            </t>
        </xpath>
    </t>
    <t t-name="l10n_reports_filter_account.PartnerLedgerFilterExtraOptions" t-inherit="account_reports.PartnerLedgerReportFilterExtraOptions" t-inherit-mode="extension">
        <xpath expr="//DropdownItem[@t-if=&quot;'hide_debit_credit' in controller.options&quot;]" position="after" >
            <DropdownItem
                t-if="controller.filters.show_exclude_zero_balance !== 'never'"
                class="{ 'selected': controller.options.exclude_zero_balance }"
                onSelected="() => this.filterClicked({
                    optionKey: 'exclude_zero_balance',
                    reload: true
                })"
            >
                Excluir balances en 0
            </DropdownItem>
        </xpath>
    </t>

        <t t-name="l10n_reports_filter_account.AccountAccountFilter">
        <Dropdown menuClass="'account_report_filter account_accounts'">
            <button class="btn btn-secondary">
                <i class="fa fa-filter me-1"/>
                Cuentas
            </button>

            <t t-set-slot="content">
                <div class="dropdown-item gap-2 align-items-center">
                    <label>Cuentas</label>

                    <MultiRecordSelector t-props="getMultiRecordSelectorProps('account.account','account_acc_ids' )"
                        domain="[[ 'account_type','in', ['asset_receivable', 'liability_payable' ]]]"/>
                </div>
            </t>
        </Dropdown>
    </t>
    <t t-name="l10n_reports_filter_account.PartnerLedgerAccountFilter" t-inherit="account_reports.PartnerLedgerFilters" t-inherit-mode="extension">
            <xpath  expr="//div[@id='filter_account_type']" position="after">
                <div id="filter_account_accounts" t-if="'account_acc_ids' in controller.options">
                    <t t-call="l10n_reports_filter_account.AccountAccountFilter"/>
                </div>
            </xpath>
        </t>
</templates>