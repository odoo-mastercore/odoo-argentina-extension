<odoo>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.l10n_ar_hr_payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        name="action_open_l10n_ar_cost_simulator"
                        type="object"
                        icon="fa-line-chart"
                        groups="hr_payroll.group_hr_payroll_user"
                        invisible="company_country_code != 'AR'">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Simulador</span>
                        <span class="o_stat_value">Incremento</span>
                    </div>
                </button>
            </xpath>
            <group name="payroll_group" position="inside">
                <group string="Argentina" invisible="company_country_code != 'AR'">
                    <field name="l10n_ar_cuil"/>
                    <field name="l10n_ar_seniority_date"/>
                    <label for="l10n_ar_seniority_percent" string="Porcentaje por antigüedad"/>
                    <div class="o_row">
                        <field name="l10n_ar_seniority_percent" class="o_hr_narrow_field"/>
                        <span>%</span>
                    </div>
                    <label for="l10n_ar_union_rate" string="Aporte sindical"/>
                    <div class="o_row">
                        <field name="l10n_ar_union_rate" class="o_hr_narrow_field"/>
                        <span>%</span>
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>
