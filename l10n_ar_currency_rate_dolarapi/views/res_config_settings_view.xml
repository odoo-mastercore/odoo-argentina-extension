<odoo>
    <record id="res_config_settings_view_form_inherit_dolarapi" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dolarapi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='update_exchange_rates']" position="inside">
                <div class="row mt16" invisible="not module_currency_rate_live">
                    <label string="Argentina source" for="dolarapi_data_source" class="col-lg-3 o_light_label"/>
                    <field name="dolarapi_data_source"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>