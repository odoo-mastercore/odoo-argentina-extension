<odoo>

    <record id="view_mp_preapproval_list" model="ir.ui.view">
        <field name="name">mp.preapproval.list</field>
        <field name="model">mp.preapproval</field>
        <field name="arch" type="xml">
            <list string="Suscripciones MP">
                <field name="name"/>
                <field name="payer_email"/>
                <field name="plan_id"/>
                <field name="transaction_amount"/>
                <field name="currency_id"/>
                <field name="status" decoration-success="status == 'authorized'" decoration-warning="status == 'paused'" decoration-danger="status == 'cancelled'"/>
                <field name="next_payment_date"/>
                <field name="last_charged_date"/>
                <field name="charged_amount_total"/>
                <field name="mp_id"/>
            </list>
        </field>
    </record>

    <record id="view_mp_preapproval_form" model="ir.ui.view">
        <field name="name">mp.preapproval.form</field>
        <field name="model">mp.preapproval</field>
        <field name="arch" type="xml">
            <form string="Suscripción MP">
                <header>
                    <button name="action_create_in_mp" type="object" string="Crear en MP" class="btn-primary" invisible="mp_id"/>
                    <button name="action_sync_from_mp" type="object" string="Sincronizar" invisible="not mp_id"/>
                    <button name="action_pause" type="object" string="Pausar" invisible="status != 'authorized'"/>
                    <button name="action_resume" type="object" string="Reanudar" invisible="status != 'paused'"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="status in ('cancelled', 'finished') or not status" confirm="Esta acción es irreversible. ¿Cancelar la suscripción en MP?"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,authorized,paused,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="reason"/>
                        <h1><field name="reason"/></h1>
                    </div>
                    <group>
                        <group string="Identificación">
                            <field name="provider_id" options="{'no_create': True}"/>
                            <field name="plan_id" options="{'no_create': True}"/>
                            <field name="mp_id" readonly="1"/>
                            <field name="external_reference"/>
                            <field name="sale_order_id"/>
                        </group>
                        <group string="Suscriptor">
                            <field name="payer_email"/>
                            <field name="payer_first_name" readonly="1"/>
                            <field name="payer_last_name" readonly="1"/>
                            <field name="payer_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Recurrencia">
                            <field name="auto_recurring_frequency"/>
                            <field name="auto_recurring_frequency_type"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group string="Monto y moneda">
                            <field name="transaction_amount"/>
                            <field name="currency_id"/>
                            <field name="back_url" widget="url"/>
                        </group>
                    </group>
                    <group string="Tarjeta y firma">
                        <field name="card_token_id_value" password="True" invisible="mp_id"/>
                        <field name="mp_card_id" readonly="1" invisible="not mp_card_id"/>
                        <field name="payment_method_id_mp" readonly="1" invisible="not payment_method_id_mp"/>
                        <field name="init_point" widget="url" readonly="1" invisible="not init_point"/>
                    </group>
                    <group string="Cobros">
                        <group>
                            <field name="next_payment_date" readonly="1"/>
                            <field name="last_charged_date" readonly="1"/>
                            <field name="last_charged_amount" readonly="1"/>
                        </group>
                        <group>
                            <field name="charged_amount_total" readonly="1"/>
                            <field name="charged_quantity" readonly="1"/>
                            <field name="pending_charge_quantity" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cuotas" name="authorized_payments">
                            <field name="authorized_payment_ids" readonly="1">
                                <list>
                                    <field name="debit_date"/>
                                    <field name="status"/>
                                    <field name="transaction_amount"/>
                                    <field name="currency_id"/>
                                    <field name="payment_status"/>
                                    <field name="invoice_id"/>
                                    <field name="mp_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mp_preapproval" model="ir.actions.act_window">
        <field name="name">Suscripciones MP</field>
        <field name="res_model">mp.preapproval</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
