<odoo>
    <record id="hr_contract_template_view_form" model="ir.ui.view">
        <field name="name">hr.contract.template.view.form.inherit.l10n_ar_hr_payroll</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr_payroll.hr_contract_template_view_form"/>
        <field name="arch" type="xml">
            <group name="salary_info" position="inside">
                <group string="Argentina" invisible="country_code != 'AR'">
                    <field name="l10n_ar_seniority_date"/>
                    <label for="l10n_ar_seniority_percent" string="Porcentaje por antigüedad"/>
                    <div class="o_row">
                        <field name="l10n_ar_seniority_percent" class="o_hr_narrow_field"/>
                        <span>%</span>
                    </div>
                    <label for="l10n_ar_union_rate" string="Aporte sindical"/>
                    <div class="o_row">
                        <field name="l10n_ar_union_rate" class="o_hr_narrow_field"/>
                        <span>%</span>
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>

