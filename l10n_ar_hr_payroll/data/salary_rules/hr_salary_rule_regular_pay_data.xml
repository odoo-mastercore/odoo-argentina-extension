    <record id="l10n_ar_regular_union_salary_rule" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="name">Aporte Sindical</field>
        <field name="sequence">113</field>
        <field name="code">AR_SINDICATO</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = bool(version.l10n_ar_union_rate)</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
